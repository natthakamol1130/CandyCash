# CandyCash Environment Variables (Placeholder values only — never commit real secrets)

# PostgreSQL connection string (Cloud Run injects this from Secret Manager)
DATABASE_URL="postgresql://candycash:change-me@localhost:5432/candycash?schema=public"

# Secret key for signing HTTP-only JWT session cookies (HS256)
JWT_SECRET="change-me-to-a-long-random-secret"

# Listening port (Cloud Run injects PORT automatically; defaults to 3000 locally)
# PORT=3000

# Runtime mode ("development" locally, "production" on Cloud Run)
# NODE_ENV=development

# Initial administrator password for prisma/seed.ts (required when NODE_ENV=production)
# ADMIN_PASSWORD=change-me

# Seed demo accounts and sample data (default: true locally, false in production)
# SEED_DEMO_DATA=false
# DEMO_USER_PASSWORD=change-me
